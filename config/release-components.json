        "version.txt",
        "gradle.properties",
        "gradle/build-logic/gradle.properties"
      ],
      "releaseChannels": [
        "stable",
        "beta",
        "snapshot"
      ],
      "dependsOnReleaseOf": []
    }
  },
  "sharedInfraPaths": {
    ".github/workflows/release-please.yml": [
      "rook",
      "cerebro",
      "corvus-runtime",
      "gradle-kmp"
