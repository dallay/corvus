{
  "components": {
    "rook": {
      "publishPolicy": "publishable",
      "ownedPaths": [
        "clients/rook/"
      ],
      "versionSurfaces": [
        "version.txt",
        "clients/rook/Cargo.toml",
        "clients/rook/npm/rook/package.json"
      ],
      "releaseChannels": [
        "stable",
        "beta"
      ],
      "dependsOnReleaseOf": []
    },
    "cerebro": {
      "publishPolicy": "publishable",
      "ownedPaths": [
        "clients/cerebro/"
      ],
      "versionSurfaces": [
        "version.txt",
        "clients/cerebro/Cargo.toml"
      ],
      "releaseChannels": [
        "stable",
        "beta"
      ],
      "dependsOnReleaseOf": []
    },
    "corvus-runtime": {
      "publishPolicy": "publishable",
      "ownedPaths": [
        "clients/agent-runtime/"
      ],
      "versionSurfaces": [
        "version.txt",
        "clients/agent-runtime/Cargo.toml",
        "clients/agent-runtime/npm/corvus/package.json"
      ],
      "releaseChannels": [
        "stable",
        "beta"
      ],
      "dependsOnReleaseOf": [
        "cerebro"
