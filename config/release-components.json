      "gradle-kmp"
    ],
    ".github/workflows/_publish.yml": [
      "rook",
      "cerebro",
      "corvus-runtime",
      "gradle-kmp"
    ],
    "release-please-config.json": [
      "rook",
      "cerebro",
      "corvus-runtime"
    ],
    "release-please-beta-config.json": [
      "rook",
      "cerebro",
      "corvus-runtime"
    ],
    "scripts/release-contract.test.mjs": [
