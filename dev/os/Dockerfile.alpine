# syntax=docker/dockerfile:1

# Corvus Agent Testing Environment - Alpine Linux
# =================================================
# This image provides a controlled environment for testing the Corvus agent
# installation script and validating its functionality on Alpine Linux.
#
# Note: Alpine is a minimal distribution, ideal for testing edge cases and
# ensuring Corvus works in resource-constrained environments.
#
# Build:   docker build -f dev/os/Dockerfile.alpine -t corvus-test:alpine .
# Run:     docker run -it corvus-test:alpine sh

FROM alpine:3.20

# ═══════════════════════════════════════════════════════════════════════════════
# Base System - Essential Tools
# ═══════════════════════════════════════════════════════════════════════════════
RUN apk add --no-cache \
    # Core utilities for agent operations
    curl \
    wget \
    git \
    vim \
    nano \
    unzip \
    zip \
    tar \
    gzip \
    # Build tools (for compiling dependencies)
    build-base \
    pkgconf \
    # SSL/TLS support
    ca-certificates \
    openssl \
    # Network utilities
    iputils \
    bind-tools \
    net-tools \
    # Process and system info
    procps \
    htop \
    # Text processing (gawk provides awk in Alpine)
    grep \
    sed \
    gawk \
    findutils \
    # Compression utilities
    bzip2 \
    xz

# ═══════════════════════════════════════════════════════════════════════════════
# Shell & User Experience
# ═══════════════════════════════════════════════════════════════════════════════
RUN apk add --no-cache bash-completion

# ═══════════════════════════════════════════════════════════════════════════════
# Corvus Agent Installation Testing Prerequisites
# ═══════════════════════════════════════════════════════════════════════════════
# Install Rust toolchain (required for building Corvus from source)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable
ENV PATH="/root/.cargo/bin:${PATH}"
ENV RUSTUP_HOME="/root/.cargo"
ENV CARGO_HOME="/root/.cargo"

# Install Node.js 20 LTS (for npm-based Corvus installation)
RUN apk add --no-cache nodejs npm

# Install Python 3 and pip
RUN apk add --no-cache python3 py3-pip

# ═══════════════════════════════════════════════════════════════════════════════
# Non-root User Setup (for security testing)
# ═══════════════════════════════════════════════════════════════════════════════
RUN mkdir -p /etc/sudoers.d && \
    adduser -D -u 1000 tester && \
    echo "tester ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/tester && \
    chmod 0440 /etc/sudoers.d/tester

# Create workspace directory
RUN mkdir -p /home/tester/workspace && chown -R tester:tester /home/tester

# Switch to non-root user
USER tester
WORKDIR /home/tester/workspace

# ═══════════════════════════════════════════════════════════════════════════════
# Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
ENV HOME=/home/tester
ENV USER=tester

# Default command
CMD ["/bin/sh"]
