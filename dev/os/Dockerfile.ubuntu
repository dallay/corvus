# syntax=docker/dockerfile:1

# Corvus Agent Testing Environment - Ubuntu/Debian
# ================================================
# This image provides a controlled environment for testing the Corvus agent
# installation script and validating its functionality.
#
# Build:   docker build -f dev/os/Dockerfile.ubuntu -t corvus-test:ubuntu .
# Run:     docker run -it corvus-test:ubuntu bash

FROM ubuntu:24.04

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive
ENV TERM=xterm-256color

# ═══════════════════════════════════════════════════════════════════════════════
# Base System - Essential Tools
# ═══════════════════════════════════════════════════════════════════════════════
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash-completion \
    build-essential \
    bzip2 \
    ca-certificates \
    cargo \
    curl \
    dnsutils \
    findutils \
    gawk \
    git \
    grep \
    gzip \
    htop \
    iputils-ping \
    nano \
    net-tools \
    netcat-openbsd \
    openssl \
    pkg-config \
    procps \
    rustc \
    sed \
    tar \
    tree \
    unzip \
    vim \
    wget \
    xz-utils \
    zip && \
    rm -rf /var/lib/apt/lists/* && \
    apt-get clean && \
    apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg && \
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    nodejs \
    python3 \
    python3-pip \
    python3-venv \
    && rm -rf /var/lib/apt/lists/* && \
    mkdir -p /etc/sudoers.d /home/tester/workspace && \
    useradd -m -s /bin/bash -u 1001 tester && \
    echo "tester ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/tester && \
    chmod 0440 /etc/sudoers.d/tester && \
    chown -R tester:1001 /home/tester

# ═══════════════════════════════════════════════════════════════════════════════
# Corvus Agent Installation Testing Prerequisites
# ═══════════════════════════════════════════════════════════════════════════════
# Rust is installed system-wide via apt, binaries are in /usr/bin/rustc and /usr/bin/cargo

# ═══════════════════════════════════════════════════════════════════════════════
# Non-root User Setup (for security testing)
# Note: Ubuntu 24.04 base already has UID 1000, use 1001 instead
# ═══════════════════════════════════════════════════════════════════════════════

# Switch to non-root user
USER tester
WORKDIR /home/tester/workspace

# ═══════════════════════════════════════════════════════════════════════════════
# Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
ENV HOME=/home/tester
ENV USER=tester

# Default command
CMD ["/bin/bash"]
