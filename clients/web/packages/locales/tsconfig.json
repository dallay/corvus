{
  "compilerOptions": {
    "target": "ES2022",
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext", "ESNext.Disposable"],
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": ["src/**/*.ts", "src/**/*.json"]
}
