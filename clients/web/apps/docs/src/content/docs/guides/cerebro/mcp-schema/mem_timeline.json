{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mem_timeline",
  "description": "Return chronological neighbors around a memory ID.",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "memory_id": {
          "type": "string",
          "description": "Center memory identifier."
        },
        "before": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of items before the center."
        },
        "after": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of items after the center."
        },
        "include_deleted": {
          "type": "boolean",
          "description": "Include deleted records (default false)."
        }
      },
      "required": ["memory_id"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "center_id": { "type": "string" },
        "before": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "memory_id": { "type": "string" },
              "summary": { "type": "string" },
              "timestamp": { "type": "string" }
            },
            "required": ["memory_id"],
            "additionalProperties": false
          }
        },
        "after": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "memory_id": { "type": "string" },
              "summary": { "type": "string" },
              "timestamp": { "type": "string" }
            },
            "required": ["memory_id"],
            "additionalProperties": false
          }
        }
      },
      "required": ["center_id", "before", "after"],
      "additionalProperties": false
    }
  },
  "required": ["input", "output"],
  "additionalProperties": false
}
