{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mem_get_observation",
  "description": "Fetch full observation content by memory ID.",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "memory_id": {
          "type": "string",
          "minLength": 1,
          "description": "ID de la memoria a recuperar."
        },
        "include_deleted": {
          "type": "boolean",
          "description": "¿Si se debe devolver la observación incluso si fue eliminada?"
        }
      },
      "required": ["memory_id"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "memory_id": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["active", "deleted"]
        },
        "observation": {
          "description": "Contenido de la observación recuperada (como valor JSON crudo)."
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": ["memory_id", "status"],
      "additionalProperties": false
    }
  },
  "required": ["input", "output"],
  "additionalProperties": false
}
