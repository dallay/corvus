{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mem_suggest_topic_key",
  "description": "Suggest a stable topic_key for evolving topics.",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "seed": {
          "type": "string",
          "minLength": 1,
          "description": "Texto inicial o título para derivar una clave."
        },
        "scope": {
          "type": "string",
          "description": "Ámbito opcional (actualmente reservado/ignorado)."
        }
      },
      "required": ["seed"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "topic_key": {
          "type": "string",
          "description": "La clave de tema normalizada y sugerida."
        },
        "candidates_count": {
          "type": "integer",
          "description": "Número de claves alternativas generadas."
        }
      },
      "required": ["topic_key", "candidates_count"],
      "additionalProperties": false
    }
  },
  "required": ["input", "output"],
  "additionalProperties": false
}
