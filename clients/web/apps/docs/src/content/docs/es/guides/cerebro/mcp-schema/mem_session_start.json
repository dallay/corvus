{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mem_session_start (draft/unimplemented)",
  "description": "Iniciar una nueva sesión en Cerebro (NotImplemented returning CerebroError::NotImplemented).",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Identificador de sesión generado por el cliente."
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Identificador del agente para atribución."
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "description": "Marca de tiempo RFC 3339 para el inicio de la sesión."
        },
        "metadata": {
          "type": "object",
          "description": "Metadatos opcionales de la sesión.",
          "maxProperties": 50,
          "propertyNames": { "type": "string", "maxLength": 64 },
          "additionalProperties": true
        }
      },
      "required": ["session_id"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "enum": ["started"]
        }
      },
      "required": ["session_id", "status"],
      "additionalProperties": false
    }
  },
  "required": ["input", "output"],
  "additionalProperties": false
}
