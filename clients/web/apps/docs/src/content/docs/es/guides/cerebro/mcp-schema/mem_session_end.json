{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mem_session_end",
  "description": "Marcar una sesión activa como completada.",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "ID único de la sesión a finalizar."
        },
        "ended_at": {
          "type": "string",
          "format": "date-time",
          "description": "Marca de tiempo opcional del fin de la sesión (RFC3339)."
        },
        "metadata": {
          "type": "object",
          "description": "Metadatos adicionales para adjuntar al fin de sesión.",
          "maxProperties": 50,
          "propertyNames": { "type": "string", "maxLength": 64 },
          "additionalProperties": true
        }
      },
      "required": ["session_id"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "status": {
          "type": "string",
          "enum": ["ended"]
        }
      },
      "required": ["session_id", "status"],
      "additionalProperties": false
    }
  },
  "required": ["input", "output"],
  "additionalProperties": false
}
