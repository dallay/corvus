{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mem_timeline",
  "description": "Recuperar una línea de tiempo cronológica alrededor de un registro de memoria.",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "memory_id": {
          "type": "string",
          "minLength": 1,
          "description": "ID de memoria central para la línea de tiempo."
        },
        "before": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Número de registros previos a recuperar."
        },
        "after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "Número de registros posteriores a recuperar."
        },
        "include_deleted": {
          "type": "boolean",
          "description": "Si se deben incluir registros eliminados (requiere permisos de auditoría)."
        }
      },
      "required": ["memory_id"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "center_id": { "type": "string", "minLength": 1 },
        "before": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "memory_id": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 },
              "timestamp": { "type": "string", "format": "date-time" }
            },
            "required": ["memory_id", "summary", "timestamp"],
            "additionalProperties": false
          }
        },
        "after": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "memory_id": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 },
              "timestamp": { "type": "string", "format": "date-time" }
            },
            "required": ["memory_id", "summary", "timestamp"],
            "additionalProperties": false
          }
        }
      },
      "required": ["center_id", "before", "after"],
      "additionalProperties": false
    }
  },
  "required": ["input", "output"],
  "additionalProperties": false
}
