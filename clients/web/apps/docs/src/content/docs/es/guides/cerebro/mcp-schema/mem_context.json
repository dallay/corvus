{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mem_context",
  "description": "Fetch recent context at the start of a session.",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1,
          "description": "Session identifier requesting context."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "description": "Maximum number of context items to return."
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "description": "Optional memory scope filter."
        }
      },
      "required": ["session_id"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "memory_id": { "type": "string", "minLength": 1 },
              "summary": { "type": "string", "minLength": 1 },
              "topic_key": { "type": "string", "minLength": 1 },
              "scope": { "type": "string", "minLength": 1 },
              "timestamp": { "type": "string", "format": "date-time" }
            },
            "required": ["memory_id", "summary", "topic_key", "scope", "timestamp"],
            "additionalProperties": false
          }
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": ["session_id", "items", "truncated"],
      "additionalProperties": false
    }
  },
  "required": ["input", "output"],
  "additionalProperties": false
}
