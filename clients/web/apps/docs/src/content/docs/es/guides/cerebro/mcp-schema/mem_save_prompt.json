{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mem_save_prompt (draft/unimplemented)",
  "description": "Save a prompt to Cerebro (NotImplemented returning CerebroError::NotImplemented).",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string",
          "description": "Prompt text to save."
        },
        "session_id": {
          "type": "string",
          "description": "Optional session identifier."
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": ["prompt"],
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "prompt_id": { "type": "string" },
        "status": { "type": "string", "enum": ["saved"] }
      },
      "required": ["prompt_id", "status"],
      "additionalProperties": false
    }
  },
  "required": ["input", "output"],
  "additionalProperties": false
}
