{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mem_update",
  "description": "Update an observation by memory ID.",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "memory_id": {
          "type": "string",
          "description": "Identificador de memoria a actualizar."
        },
        "observation": {
          "anyOf": [
              { "type": "object" },
              { "type": "array" },
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "null" }
          ],
          "description": "Nueva carga útil de la observación (reemplaza el contenido existente)."
        },
        "topic_key": {
          "type": "string",
          "description": "Nueva clave de tema (opcional)."
        },
        "scope": {
          "type": "string",
          "description": "Nuevo ámbito de memoria (opcional)."
        },
        "metadata": {
          "type": "object",
          "description": "Nuevos metadatos a fusionar (opcional).",
          "additionalProperties": true
        }
      },
      "required": ["memory_id"],
      "additionalProperties": true
    },
    "output": {
      "type": "object",
      "properties": {
        "memory_id": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["updated"]
        }
      },
      "required": ["memory_id", "status"],
      "additionalProperties": false
    }
  },
  "required": ["input", "output"],
  "additionalProperties": false
}
