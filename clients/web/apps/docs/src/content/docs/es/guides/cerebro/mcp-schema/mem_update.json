{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mem_update",
  "description": "Update an observation by memory ID.",
  "type": "object",
  "properties": {
    "input": {
      "type": "object",
      "properties": {
        "memory_id": {
          "type": "string",
          "description": "Memory identifier to update."
        },
        "observation": {
          "type": "object",
          "description": "New observation payload (raw JSON). Replaces the existing one if provided."
        },
        "topic_key": {
          "type": "string",
          "description": "New topic key (optional)."
        },
        "scope": {
          "type": "string",
          "description": "New memory scope (optional)."
        },
        "metadata": {
          "type": "object",
          "description": "New metadata to merge (optional).",
          "additionalProperties": true
        }
      },
      "required": ["memory_id"],
      "additionalProperties": true
    },
    "output": {
      "type": "object",
      "properties": {
        "memory_id": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["updated"]
        }
      },
      "required": ["memory_id", "status"],
      "additionalProperties": false
    }
  },
  "required": ["input", "output"],
  "additionalProperties": false
}
