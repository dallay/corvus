{
  "name": "@corvus/dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Corvus Web Dashboard",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --port 4323",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --port 4323",
    "format": "biome format --write src package.json components.json tsconfig*.json vite.config.ts index.html postcss.config.js",
    "check": "biome check src package.json components.json tsconfig*.json vite.config.ts index.html postcss.config.js",
    "test": "vitest --run"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1",
    "vue": "^3.5.22",
    "vue-i18n": "^11.2.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.15",
    "@tailwindcss/postcss": "^4.1.16",
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^24.10.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "happy-dom": "^20.0.10",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  }
}
