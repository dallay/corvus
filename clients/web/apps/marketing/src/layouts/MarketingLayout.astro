---
import "../styles/global.css";
import { AHREFS_KEY } from "astro:env/client";
import Analytics from "../components/Analytics.astro";

interface Props {
	title?: string;
	description?: string;
	image?: string;
}

const {
	title = "Corvus | Autonomous AI Infrastructure",
	description = "Corvus is a lightweight autonomous AI runtime designed for secure operations, tiny footprint, and fast deployment.",
	image = "/og-image.png",
} = Astro.props;

const canonical = Astro.site
	? new URL(Astro.url.pathname, Astro.site).toString()
	: undefined;
const ogImage = Astro.site ? new URL(image, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <meta name="theme-color" content="#0a0f1e" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <Analytics key={AHREFS_KEY} />
  </head>
  <body>
    <div class="site-backdrop" aria-hidden="true"></div>
    <slot />
  </body>
</html>
