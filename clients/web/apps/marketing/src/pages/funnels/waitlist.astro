---
import MarketingLayout from "../../layouts/MarketingLayout.astro";
---

<MarketingLayout
  title="Waitlist Funnel | Corvus"
  description="Waitlist funnel template for Corvus launches and feature drops."
>
  <main class="shell section">
    <a class="back-link" href="/funnels">← Back to funnels</a>
    <p class="eyebrow">FUNNEL TEMPLATE</p>
    <h1>Early Access Funnel</h1>
    <p class="subtitle">
      Goal: build launch demand and collect segmented users for beta invites and onboarding waves.
    </p>

    <div class="comparison-grid">
      <article>
        <h2>Flow</h2>
        <ul>
          <li>Problem-led prelaunch page</li>
          <li>Email capture with role and use-case</li>
          <li>Automated sequence with onboarding teaser</li>
        </ul>
      </article>
      <article>
        <h2>Assets</h2>
        <ul>
          <li>Feature preview cards</li>
          <li>Technical FAQ block</li>
          <li>Install wizard preview snippet</li>
        </ul>
      </article>
    </div>
  </main>
</MarketingLayout>
