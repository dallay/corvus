---
import { resolvePublicUrl } from "@corvus/shared";
import { PORTS } from "@corvus/shared/env";
import { loadEnv } from "vite";
import MarketingLayout from "../layouts/MarketingLayout.astro";

const DEFAULT_MARKETING_DEV_URL = `http://localhost:${PORTS.MARKETING}`;
const DEFAULT_MARKETING_PROD_URL = "https://profiletailors.com";
const DEFAULT_DOCS_DEV_URL = `http://localhost:${PORTS.DOCS}`;
const DEFAULT_DOCS_PROD_URL = "https://docs.profiletailors.com";

const mode = process.env.NODE_ENV || "production";
const env = loadEnv(mode, process.cwd(), "");

const isProdLike = mode === "production";
const portlessUrl = isProdLike
  ? ""
  : resolvePublicUrl(process.env.PORTLESS_URL ?? env.PORTLESS_URL, "");
const marketingBaseUrl = resolvePublicUrl(
  env.MARKETING_URL ?? (portlessUrl || undefined),
  isProdLike ? DEFAULT_MARKETING_PROD_URL : DEFAULT_MARKETING_DEV_URL
);
const docsBaseUrl = resolvePublicUrl(
  env.DOCS_URL,
  isProdLike ? DEFAULT_DOCS_PROD_URL : DEFAULT_DOCS_DEV_URL
);
const installScriptUrl = `${marketingBaseUrl}/install`;
const githubUrl = "https://github.com/dallay/corvus";

const productHighlights = [
  {
    title: "Fast to ship",
    body: "Start quickly with a small Rust binary, fast startup, and low memory usage that stays practical from local machines to edge hardware.",
  },
  {
    title: "Safe by default",
    body: "Pairing, sandboxing, workspace scoping, allowlists, encrypted secrets, and controlled public exposure are built in from day one.",
  },
  {
    title: "Fits your stack",
    body: "Swap providers, channels, tools, memory, and runtimes without rebuilding everything around one vendor or framework.",
  },
  {
    title: "No lock-in",
    body: "Use OpenRouter, OpenAI-compatible endpoints, local setups, or custom integrations without painting your team into a corner.",
  },
  {
    title: "Deploy where it makes sense",
    body: "Run natively or in Docker, from local-first development to secure remote gateway setups with tunnels and controlled exposure.",
  },
  {
    title: "Built for real workflows",
    body: "Chat, gateway, daemon, memory, channels, scheduled tasks, integrations, and service management work as one coherent runtime.",
  },
];

const installMethods = [
  {
    title: "One-line install",
    description:
      "Paste one command, install Corvus, and get to a working binary in the fastest possible path.",
    command: "curl -fsSL https://profiletailors.com/install | bash",
    ctaLabel: "Open install guide",
    ctaHref: `${docsBaseUrl}/guides/getting-started/`,
  },
  {
    title: "Node package managers",
    description:
      "Stay inside your usual JS tooling and install the Corvus launcher with npm, pnpm, yarn, or bun.",
    commands: [
      "npm i -g @dallay/corvus",
      "pnpm add -g @dallay/corvus",
      "yarn global add @dallay/corvus",
      "bun add -g @dallay/corvus",
    ],
    ctaLabel: "Read CLI docs",
    ctaHref: `${docsBaseUrl}/guides/cli-reference/`,
  },
  {
    title: "Build locally",
    description:
      "Build from source when you want the native Rust path, custom features, or the full contributor setup.",
    command:
      "git clone https://github.com/dallay/corvus.git\ncd corvus\ncargo build --release\ncargo install --path . --force",
    ctaLabel: "Read architecture docs",
    ctaHref: `${docsBaseUrl}/guides/architecture/`,
  },
];

const stats = [
  { value: "< 10ms", label: "startup time" },
  { value: "3.4MB", label: "release binary" },
  { value: "22+", label: "providers" },
];

const quickLinks = [
  {
    title: "Getting started",
    body: "Pick an install path, run the first command, and get Corvus responding without digging through repo internals.",
    href: `${docsBaseUrl}/guides/getting-started/`,
  },
  {
    title: "CLI reference",
    body: "Jump straight to real commands for agent, daemon, gateway, doctor, channels, and services.",
    href: `${docsBaseUrl}/guides/cli-reference/`,
  },
  {
    title: "Architecture",
    body: "See how providers, memory, tools, channels, and security fit together before you roll it out wider.",
    href: `${docsBaseUrl}/guides/architecture/`,
  },
];

const workflowSteps = [
  {
    title: "Install your way",
    body: "Choose the hosted shell installer, a Node launcher, or the native Rust build path without changing your workflow.",
  },
  {
    title: "Run the first command",
    body: "Check health with `corvus doctor`, inspect status, or launch an agent in minutes, not hours.",
  },
  {
    title: "Expand safely",
    body: "Add providers, channels, memory, and gateway exposure behind explicit controls and docs-backed setup.",
  },
];

const faqGroups = [
  {
    title: "Product and fit",
    items: [
      {
        question: "What is Corvus?",
        points: [
          "Corvus is a Rust-native runtime for autonomous AI agents.",
          "It combines model access, memory, tools, channels, and security controls into one portable system.",
          "It is designed to behave like infrastructure, not a fragile demo stack.",
        ],
        ctaLabel: "Read the architecture",
        ctaHref: `${docsBaseUrl}/guides/architecture/`,
      },
      {
        question: "Who is it for?",
        points: [
          "Corvus fits developers, platform teams, and operators who want portable agent infrastructure.",
          "It is a strong fit when security posture, runtime efficiency, and provider flexibility matter.",
          "It helps teams avoid heavyweight stacks and unnecessary lock-in.",
        ],
        ctaLabel: "See the quick start",
        ctaHref: `${docsBaseUrl}/guides/getting-started/`,
      },
    ],
  },
  {
    title: "Security and operations",
    items: [
      {
        question: "How does Corvus protect data and tools?",
        points: [
          "Pairing, sandboxing, workspace isolation, command allowlisting, and forbidden path protection are built in.",
          "Gateway exposure is restrictive by default, with localhost binding and tunnel-aware controls.",
          "Secrets can be encrypted locally and public access is never assumed.",
        ],
        ctaLabel: "Review security controls",
        ctaHref: `${docsBaseUrl}/guides/architecture/`,
      },
      {
        question: "Where can it run?",
        points: [
          "Corvus runs as a native binary or in Docker.",
          "It is built to stay practical across laptops, servers, SBCs, and constrained environments.",
          "Its small binary size and fast startup make it viable beyond heavyweight cloud-only setups.",
        ],
        ctaLabel: "Explore runtime options",
        ctaHref: `${docsBaseUrl}/guides/getting-started/`,
      },
    ],
  },
];

const hero = {
  eyebrow: "INSTALL FAST • KEEP CONTROL • DEPLOY ANYWHERE",
  title: "Run Corvus fast, without losing control.",
  subtitle:
    "Install from one command, package managers, or source. Corvus gives teams a practical Rust-native runtime for agents, gateway, memory, channels, and secure execution without the usual heavyweight stack.",
  primaryCta: "See install methods",
  secondaryCta: "Open docs",
};
---

<MarketingLayout
  title="Profile Tailors | Install Corvus Fast"
  description="Install Corvus from one command, package managers, or source. Profile Tailors gives teams a fast path into the secure Rust-native agent runtime."
>
  <header class="topbar shell">
    <a class="brand" href="/">
      <img src="/favicon-light.svg" alt="" class="brand-mark" width="28" height="28" aria-hidden="true" />
      Corvus
    </a>
    <nav class="topbar-nav" aria-label="Primary">
      <a href="#install">Install</a>
      <a href="#why">Why Corvus</a>
      <a href="#docs">Docs</a>
      <a href="#faq">FAQ</a>
      <a class="btn btn-primary btn-nav" href={docsBaseUrl} rel="noopener noreferrer" data-track="cta_click" data-track-location="nav" data-track-label="docs-nav">Open docs</a>
    </nav>
  </header>

  <main id="main-content">
    <section class="hero shell">
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="eyebrow">{hero.eyebrow}</p>
          <h1>{hero.title}</h1>
          <p class="subtitle">{hero.subtitle}</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="#install" data-track="cta_click" data-track-location="hero" data-track-label="hero-primary">{hero.primaryCta}</a>
            <a class="btn btn-ghost" href={docsBaseUrl} rel="noopener noreferrer" data-track="cta_click" data-track-location="hero" data-track-label="hero-secondary">{hero.secondaryCta}</a>
            <a class="btn btn-ghost" href={githubUrl} rel="noopener noreferrer" data-track="cta_click" data-track-location="hero" data-track-label="hero-github">GitHub</a>
          </div>
          <p class="hero-note">Profile Tailors gives you the cleanest path in: install from `profiletailors.com/install`, use the `@dallay/corvus` launchers, or go native with Rust when you need deeper control.</p>
        </div>

        <aside class="hero-rail">
          <div class="terminal-card">
            <div class="terminal-head">
              <span aria-hidden="true"></span>
              <span aria-hidden="true"></span>
              <span aria-hidden="true"></span>
              <p>Fastest path</p>
              <button
                class="copy-button"
                type="button"
                data-copy-text="curl -fsSL https://profiletailors.com/install | bash"
                data-track="cta_click"
                data-track-location="hero-panel"
                data-track-label="copy-install-command"
                aria-label="Copy install command"
              >
                Copy
              </button>
            </div>
            <pre class="command-block"><code>curl -fsSL https://profiletailors.com/install | bash</code></pre>
            <div class="terminal-actions">
              <a href={installScriptUrl} data-track="cta_click" data-track-location="hero-panel" data-track-label="install-script">Open `/install`</a>
              <a href={`${docsBaseUrl}/guides/getting-started/`} rel="noopener noreferrer" data-track="cta_click" data-track-location="hero-panel" data-track-label="getting-started">Getting started</a>
            </div>
            <ul class="pill-row" aria-label="Supported launcher paths">
              <li>npm</li>
              <li>pnpm</li>
              <li>yarn</li>
              <li>bun</li>
            </ul>
          </div>

          <dl class="stats-grid">
            {
              stats.map((item) => (
                <div class="stat-card">
                  <dt>{item.label}</dt>
                  <dd>{item.value}</dd>
                </div>
              ))
            }
          </dl>
        </aside>
      </div>
    </section>

    <section class="section shell" id="install">
      <div class="section-head">
        <p class="eyebrow">INSTALLATION PATHS</p>
        <h2>Start the way your team actually works.</h2>
        <p class="section-copy">
          Clean install paths, real production links, and direct routes into the docs hub at
          `docs.profiletailors.com`.
        </p>
      </div>
      <div class="install-grid">
        {
          installMethods.map((item) => (
            <article class="install-card">
              <div>
                <p class="card-kicker">{item.title}</p>
                <p class="card-copy">{item.description}</p>
              </div>

              {item.command && (
                <pre class="code-block"><code>{item.command}</code></pre>
              )}

              {item.commands && (
                <ul class="command-list">
                  {item.commands.map((command) => <li><code>{command}</code></li>)}
                </ul>
              )}

              <a class="inline-link" href={item.ctaHref} rel="noopener noreferrer" data-track="cta_click" data-track-location="install" data-track-label={item.title}>
                {item.ctaLabel}
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section shell" id="why">
      <div class="section-head">
        <p class="eyebrow">WHY TEAMS PICK CORVUS</p>
        <h2>Everything teams need to get moving without dragging extra weight.</h2>
      </div>
      <div class="feature-grid">
        {
          productHighlights.map((item) => (
            <article class="feature-card">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section shell workflow">
      <div class="section-head">
        <p class="eyebrow">HOW TO GET MOVING</p>
        <h2>From install to useful output without guesswork.</h2>
      </div>
      <div class="workflow-grid">
        {
          workflowSteps.map((item, index) => (
            <article class="workflow-card">
              <p class="step-number">0{index + 1}</p>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section shell" id="docs">
      <div class="section-head">
        <p class="eyebrow">DOCUMENTATION HUB</p>
        <h2>Jump straight into the docs that unblock the next step.</h2>
      </div>
      <div class="docs-grid">
        {
          quickLinks.map((item) => (
            <article class="docs-card">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
              <a class="inline-link" href={item.href} rel="noopener noreferrer" data-track="cta_click" data-track-location="docs" data-track-label={item.title}>
                Open docs
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section shell faq" id="faq">
      <div class="section-head">
        <p class="eyebrow">FAQ</p>
        <h2>Clear answers for teams evaluating a serious runtime.</h2>
      </div>

      <div class="faq-grid">
        {
          faqGroups.map((group) => (
            <article class="faq-group">
              <h3>{group.title}</h3>
              <div class="faq-list">
                {
                  group.items.map((item) => (
                    <details data-track-group={group.title}>
                      <summary>{item.question}</summary>
                      <ul>
                        {item.points.map((point) => <li>{point}</li>)}
                      </ul>
                      <a href={item.ctaHref} rel="noopener noreferrer" data-track="faq_cta_click" data-track-location={group.title} data-track-label={item.question}>{item.ctaLabel} →</a>
                    </details>
                  ))
                }
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="section shell cta-band">
      <h2>Install from the main domain, jump into docs, and keep shipping.</h2>
      <p>
        The landing now gives users the shell installer, package manager commands, source build path,
        and direct links into `docs.profiletailors.com` without bouncing through preview URLs.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={installScriptUrl} data-track="cta_click" data-track-location="final-cta" data-track-label="download-installer">Open `/install`</a>
        <a class="btn btn-ghost" href={docsBaseUrl} rel="noopener noreferrer" data-track="cta_click" data-track-location="final-cta" data-track-label="explore-docs">Explore the docs</a>
      </div>
    </section>
  </main>

  <footer class="shell footer">
    <p>© {new Date().getFullYear()} Corvus</p>
    <div class="footer-links">
      <a href={docsBaseUrl} rel="noopener noreferrer">Docs</a>
      <a href={githubUrl} rel="noopener noreferrer">GitHub</a>
      <a href={installScriptUrl}>Install</a>
    </div>
  </footer>

  <script>
    const metricsKey = "corvus_marketing_metrics_v1";
    const currentDevice = window.matchMedia("(max-width: 960px)").matches ? "mobile" : "desktop";

    function pushMetric(name: string, detail: Record<string, string> = {}) {
      const payload = {
        name,
        timestamp: new Date().toISOString(),
        path: window.location.pathname,
        device: currentDevice,
        ...detail,
      };

      let previous: Array<Record<string, string>> = [];

      try {
        const raw = window.localStorage.getItem(metricsKey);
        if (raw) {
          const parsed = JSON.parse(raw);
          previous = Array.isArray(parsed) ? parsed : [];
        }
      } catch {
        previous = [];
      }

      try {
        previous.push(payload);
        window.localStorage.setItem(metricsKey, JSON.stringify(previous.slice(-100)));
      } catch {
        // Ignore persistence failures and still emit the analytics event.
      }

      window.dispatchEvent(new CustomEvent("corvus:analytics", { detail: payload }));
    }

    document.querySelectorAll("[data-track]").forEach((element) => {
      element.addEventListener("click", () => {
        pushMetric(element.getAttribute("data-track") ?? "interaction", {
          location: element.getAttribute("data-track-location") ?? "unknown",
          label: element.getAttribute("data-track-label") ?? "unknown",
        });
      });
    });

    document.querySelectorAll("details[data-track-group]").forEach((element) => {
      element.addEventListener("toggle", () => {
        if (!(element instanceof HTMLDetailsElement) || !element.open) {
          return;
        }

        const summary = element.querySelector("summary");
        pushMetric("faq_open", {
          location: element.getAttribute("data-track-group") ?? "faq",
          label: summary?.textContent?.trim() ?? "faq-item",
        });
      });
    });

    document.querySelectorAll("[data-copy-text]").forEach((element) => {
      element.addEventListener("click", async () => {
        if (!(element instanceof HTMLButtonElement)) {
          return;
        }

        const copyText = element.getAttribute("data-copy-text");
        if (!copyText) {
          return;
        }

        const originalLabel = element.textContent ?? "Copy";
        const locationLabel = element.getAttribute("data-track-location") ?? "unknown";
        const trackLabel = element.getAttribute("data-track-label") ?? "unknown";

        try {
          if (!navigator.clipboard || !window.isSecureContext) {
            element.textContent = "Copy unavailable (insecure context)";
            element.classList.remove("is-copied");
            pushMetric("command_copy_failed", {
              location: locationLabel,
              label: trackLabel,
              reason: "insecure_context",
            });
          } else {
            await navigator.clipboard.writeText(copyText);
            element.textContent = "Copied";
            element.classList.add("is-copied");
            pushMetric("command_copy", {
              location: locationLabel,
              label: trackLabel,
            });
          }
        } catch (error) {
          const message = error instanceof Error ? error.message : "unknown error";
          console.error("Clipboard copy failed", error);
          element.textContent = `Copy failed: ${message}`;
          element.classList.remove("is-copied");
          pushMetric("command_copy_failed", {
            location: locationLabel,
            label: trackLabel,
            reason: message,
          });
        }

        window.setTimeout(() => {
          element.textContent = originalLabel;
          element.classList.remove("is-copied");
        }, 1600);
      });
    });
  </script>
</MarketingLayout>
