{
  "name": "@corvus/chat",
  "version": "0.2.3",
  "private": true,
  "description": "Corvus Chat — conversational AI interface",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --port 4323",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --port 4323",
    "format": "biome format --write src package.json components.json tsconfig*.json vite.config.ts index.html",
    "check": "biome check src package.json components.json tsconfig*.json vite.config.ts index.html",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.6",
    "tailwind-merge": "catalog:",
    "vue": "catalog:",
    "vue-i18n": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@tsconfig/node22": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vue/test-utils": "catalog:",
    "@vue/tsconfig": "catalog:",
    "happy-dom": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "catalog:"
  }
}
