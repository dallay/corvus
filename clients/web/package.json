{
  "name": "@corvus/web-monorepo",
  "version": "0.4.0",
  "private": true,
  "description": "Corvus Web Apps Monorepo - Marketing, Docs, Chat, Dashboard",
  "type": "module",
  "scripts": {
    "update-deps": "pnpm update -i -r --latest",
    "build": "pnpm -r run build",
    "build:docs": "pnpm --filter @corvus/docs run build",
    "build:marketing": "pnpm --filter @corvus/marketing run build",
    "build:landing": "pnpm run build:marketing",
    "build:chat": "pnpm --filter @corvus/chat run build",
    "build:dashboard": "pnpm --filter @corvus/dashboard run build",
    "dev": "pnpm --parallel -r run dev",
    "dev:docs": "pnpm --filter @corvus/docs run dev",
    "dev:marketing": "pnpm --filter @corvus/marketing run dev",
    "dev:landing": "pnpm run dev:marketing",
    "dev:chat": "pnpm --filter @corvus/chat run dev",
    "dev:dashboard": "pnpm --filter @corvus/dashboard run dev",
    "format": "pnpm -r run format",
    "check": "pnpm -r run check",
    "clean": "pnpm -r run clean",
    "test": "pnpm -r run test",
    "test:chat": "pnpm --filter @corvus/chat run test",
    "test:dashboard": "pnpm --filter @corvus/dashboard run test",
    "test:dashboard:e2e": "pnpm --filter @corvus/dashboard run test:e2e",
    "test:dashboard:e2e:install": "pnpm --filter @corvus/dashboard run test:e2e:install"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "typescript": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "minimatch": "^9.0.6",
      "lodash@>=4.17.0 <4.17.23": "^4.17.23",
      "devalue": "^5.6.3",
      "rollup": "^4.59.0"
    }
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.28.0"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8"
  }
}
