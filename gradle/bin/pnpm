#!/usr/bin/env bash
set -euo pipefail

if command -v npm >/dev/null 2>&1; then
  npm_exec="$(command -v npm)"
elif [ -x "/opt/homebrew/bin/npm" ]; then
  npm_exec="/opt/homebrew/bin/npm"
else
  echo "npm was not found in PATH and /opt/homebrew/bin/npm is unavailable." >&2
  exit 127
fi

exec "${npm_exec}" exec --yes pnpm -- "$@"
