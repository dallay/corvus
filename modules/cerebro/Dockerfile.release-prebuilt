# syntax=docker/dockerfile:1

FROM busybox:1.37.0 AS prep

ARG TARGETARCH

RUN mkdir -p /cerebro-data /etc/cerebro

COPY modules/cerebro/dist/cerebro-linux-x64 /tmp/cerebro-linux-x64
COPY modules/cerebro/dist/cerebro-linux-arm64 /tmp/cerebro-linux-arm64

RUN case "$TARGETARCH" in \
  amd64) cp /tmp/cerebro-linux-x64 /tmp/cerebro ;; \
  arm64) cp /tmp/cerebro-linux-arm64 /tmp/cerebro ;; \
  *) echo "Unsupported TARGETARCH=$TARGETARCH" && exit 1 ;; \
esac

# WARNING: Override surreal password in production via mounted config or env
# Default config: bind to all interfaces for container use
RUN printf '%s\n' \
  'host = "0.0.0.0"' \
  'port = 4040' \
  'storage_mode = "embedded_surreal"' \
  '' \
  '[surreal]' \
  'namespace = "cerebro"' \
  'database = "cerebro"' \
  'username = "root"' \
  'password = "CHANGE_ME_BEFORE_PRODUCTION"' \
  > /etc/cerebro/config.toml

RUN chmod +x /tmp/cerebro \
  && chown -R 65532:65532 /cerebro-data /etc/cerebro

FROM gcr.io/distroless/cc-debian13:nonroot AS release

COPY --from=prep /tmp/cerebro /usr/local/bin/cerebro
COPY --from=prep /cerebro-data /cerebro-data
COPY --from=prep /etc/cerebro/config.toml /etc/cerebro/config.toml

ENV HOME=/cerebro-data

WORKDIR /cerebro-data
USER 65532:65532
EXPOSE 4040
# NOTE: Distroless has no shell; use orchestrator probes (K8s, Compose) against POST /mcp
ENTRYPOINT ["cerebro"]
CMD ["serve", "--config", "/etc/cerebro/config.toml"]
